@startuml
skinparam defaultFontName DejaVu Sans
skinparam classBackgroundColor #F3F3FA
skinparam classBorderColor #003772
interface "Copiable<T>" as C {
+ copiar(): T
}
class "PerfilSensor" as P {
- nombre: String
- reglas: List<ReglaUmbral>
+ copiar(): PerfilSensor
~ ajustarLimite(indice, limite)
}
class "ReglaUmbral" as R {
- magnitud: String
- limite: double
~ cambiarLimite(nuevo)
~ copiar(): ReglaUmbral
}
P ..|> C : T = PerfilSensor
P ..> R : contiene y copia 0..*
@enduml
