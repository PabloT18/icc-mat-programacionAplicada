@startuml
skinparam defaultFontName DejaVu Sans
skinparam classBackgroundColor #F3F3FA
skinparam classBorderColor #003772
interface "Parametros" as P {
+ intervalo(): Duration
+ unidad(): String
}
enum "Configuracion" as C {
INSTANCIA {static, final}
- intervalo: Duration
- unidad: String
+ intervalo(): Duration
+ unidad(): String
}
class "ServicioMuestreo" as S {
- parametros: Parametros
~ ServicioMuestreo(parametros)
~ describir(sensor): String
}
C ..|> P
S ..> P : recibe
@enduml
